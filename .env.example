# ==============================================================================
# 🚆 Ujjwal Rail Travel Assistant - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Grok (xAI) LLM Configuration
# ------------------------------------------------------------------------------
# Sign up at https://console.x.ai/ to get your Grok API key
GROK_API_KEY=your_grok_api_key_here

# Grok API Base URL (OpenAI-compatible endpoint)
GROK_BASE_URL=https://api.x.ai/v1

# Grok Model Selection:
# - grok-2-latest  (Flagship reasoning and chat model)
# - grok-2         (Standard release)
# - grok-beta      (Fast preview model)
GROK_MODEL=grok-2-latest

# MOCK_LLM Flag:
# - Set to "false" to use live Grok API for conversational and RAG answers
# - Set to "true" for offline deterministic evaluation runner & test suite
MOCK_LLM=false

# ------------------------------------------------------------------------------
# 2. Server & Network Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. Application & Passenger Defaults
# ------------------------------------------------------------------------------
DEFAULT_PASSENGER_ID=PASS-001
DEFAULT_TIMEZONE=Asia/Kolkata
